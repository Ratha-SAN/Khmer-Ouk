rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /sessions/{sessionId} {
      allow create: if true;
      allow update: if true;
      allow read, delete: if false;
    }
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /games/{gameId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
    // Public matchmaking lobbies: anyone signed in can browse open ones
    // (needed to find a quick match or look up a code), only the host can
    // touch their own lobby otherwise, and claiming an open one (becoming
    // its guest) is the one write a non-host is allowed to make.
    match /lobbies/{lobbyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.hostUid == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.hostUid == request.auth.uid ||
        (resource.data.status == 'open' && request.resource.data.guestUid == request.auth.uid)
      );
      allow delete: if request.auth != null && resource.data.hostUid == request.auth.uid;
    }
    // Live match state: only the two matched players can ever read or
    // write their own game document.
    match /matches/{matchId} {
      allow create: if request.auth != null && (
        request.resource.data.players.white == request.auth.uid ||
        request.resource.data.players.black == request.auth.uid
      );
      allow read, update: if request.auth != null && (
        request.auth.uid == resource.data.players.white ||
        request.auth.uid == resource.data.players.black
      );
    }
    // The Telegram Mini App's Google sign-in hand-off (firebase-default/tg-signin/ and tgBridgeWait in
    // index.html): the phone's browser, signed in with Google, leaves the sign-in token under a one-time
    // 48-character random name; the Mini App reads it by that exact name and deletes it. Nobody can list these
    // documents, so knowing the name is the key.
    match /tgSignin/{code} {
      allow create: if request.auth != null && code.size() >= 32 &&
        request.resource.data.keys().hasOnly(['idToken', 'accessToken', 'created']) &&
        request.resource.data.idToken is string && request.resource.data.idToken.size() < 8192;
      allow get, delete: if code.size() >= 32;
      allow list, update: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
