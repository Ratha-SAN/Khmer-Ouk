# Cloudflare Pages response headers (the same cache rules as firebase.json)
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/version.json
  Cache-Control: no-cache, no-store
/data/*
  Cache-Control: public, max-age=31536000, immutable
